@model List<ProductViewModel>

@{
    ViewData["Title"] = "Products";
}
<div class="row mt-3">
    @await Html.PartialAsync("SideBar")
    <div class="col-9 mb-3">
        <div class="text-center text-uppercase text-success mb-5 mt-5">
            <h2 class="row-title">Products</h2>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            <div class="row justify-content-center mt-3">
                <div class="col-12">
                    <div class="text-end">
                        <a class="btn btn-outline-success mb-2 mt-2"
                           asp-area="Admin"
                           asp-controller="Product"
                           asp-action="Add">
                            Add new product
                        </a>
                    </div>
                    <table class="table table-responsive table-striped table-hover mb-5">
                        <thead>
                            <tr align="center">
                                <th scope="col">#</th>
                                <th scope="col">Product name</th>
                                <th scope="col">Price, usd</th>
                                <th scope="col"></th>
                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Count; i++)
                            {
                                <tr align="center" class="align-baseline">
                                    <td class="fw-bold">@(i + 1)</td>
                                    <td align="left">
                                        <a class="text-success"
                                           asp-area="Admin"
                                           asp-controller="Product"
                                           asp-action="Index"
                                           asp-route-Id="@Model[i].Id">
                                            <h5>@Model[i].Name</h5>
                                        </a>
                                    </td>
                                    <td>@Model[i].Cost</td>
                                    <td>
                                        <a class="btn btn-outline-success"
                                           asp-area="Admin"
                                           asp-controller="Product"
                                           asp-action="Edit"
                                           asp-route-Id="@Model[i].Id">
                                            Edit
                                        </a>
                                    </td>
                                    <td>
                                        <button type="button"
                                                class="btn btn-outline-success"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal-product-@Model[i].Id">
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr align="center">
                                <th colspan="2"></th>
                                <th colspan="3">
                                    Total amount of products: @Model.Count
                                </th>
                            </tr>
                        </tfoot>
                    </table>
                    @for (var i = 0; i < Model.Count; i++)
                    {
                        @await Html.PartialAsync("_DeleteConfirmModal", new DeleteConfirmModalModel
                        {
                            ModalId = $"deleteModal-product-{Model[i].Id}",
                            Message = $"Are you sure you want to delete product \"{Model[i].Name}\"?",
                            DeleteUrl = Url.Action("Delete", "Product", new { area = "Admin", Id = Model[i].Id })
                        })
                    }
                </div>
            </div>
        }
        else
        {
            <div class="text-center">
                <h2 class="row-title">There are no products in the warehouse!</h2>
            </div>
            <div class="text-center mt-5">
                <a class="btn btn-outline-success mb-2 mt-2"
                   asp-area="Admin"
                   asp-controller="Product"
                   asp-action="Add">
                    Add new product
                </a>
            </div>
        }
    </div>
</div>