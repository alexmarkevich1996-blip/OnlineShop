@using OnlineShop.Areas.Admin.ViewModels
@using OnlineShop.Core.Models
@model List<Role>
@{
    ViewData["Title"] = "Роли";
}

<div class="row mt-3">
    @await Html.PartialAsync("SideBar")
    <div class="col-9 mb-3">
        <div class="text-center text-uppercase text-success mb-5 mt-5">
            <h2 class="row-title">Roles</h2>
        </div>

        @if (Model?.Count > 0)
        {
            <div class="row justify-content-center mt-3">
                <div class="col-12">
                    <div class="text-end">
                        <a class="btn btn-outline-success mb-2 mt-2"
                           asp-area="Admin"
                           asp-controller="Role"
                           asp-action="Add">
                            Add new role
                        </a>
                    </div>
                    <table class="table table-responsive table-striped table-hover mb-5">
                        <thead>
                        <tr align="center">
                            <th scope="col">#</th>
                            <th scope="col">Role Name</th>
                            <th scope="col"></th>
                        </tr>
                        </thead>
                        <tbody>
                        @for (var i = 0; i < Model.Count; i++)
                        {
                            <tr align="center" class="align-baseline">
                                <td class="fw-bold">@(i + 1)</td>
                                <td align="left">
                                    <h5>@Model[i].Name</h5>
                                </td>
                                <td>
                                    <button type="button"
                                            class="btn btn-outline-success"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal-role-@Model[i].Id">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                        </tbody>
                        <tfoot>
                        <tr align="center">
                            <th colspan="2"></th>
                            <th colspan="1">
                                Total number of roles: @Model.Count
                            </th>
                        </tr>
                        </tfoot>
                    </table>
                    @for (var i = 0; i < Model.Count; i++)
                    {
                        @await Html.PartialAsync("_DeleteConfirmModal", new DeleteConfirmModalModel
                        {
                            ModalId = $"deleteModal-role-{Model[i].Id}",
                            Message = $"Are you sure you want to delete role \"{Model[i].Name}\"?",
                            DeleteUrl = Url.Action("Delete", "Role", new { area = "Admin", roleId = Model[i].Id })
                        })
                    }
                </div>
            </div>
        }
        else
        {
            <div class="text-center">
                <h2 class="row-title">There are no roles in repository!</h2>
            </div>
            <div class="text-center mt-5">
                <a class="btn btn-outline-success mb-2 mt-2"
                   asp-area="Admin"
                   asp-controller="Role"
                   asp-action="Add">
                    Add new role
                </a>
            </div>
        }

    </div>
</div>