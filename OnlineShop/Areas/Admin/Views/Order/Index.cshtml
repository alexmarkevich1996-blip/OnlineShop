@model List<Order>
@{
    ViewData["Title"] = "Orders";
}

<div class="row mt-3">
    @await Html.PartialAsync("SideBar")
    <div class="col-9 mb-3">
        <div class="text-center text-uppercase text-success mb-5 mt-5">
            <h2 class="row-title">Orders</h2>
        </div>

        @if (Model?.Count > 0)
        {
            <div class="row justify-content-center mt-3">
                <div class="col-12">
                    <table class="table table-responsive table-striped table-hover mb-5">
                        <thead>
                            <tr align="center">
                                <th scope="col">#</th>
                                <th scope="col">Total Cost</th>
                                <th scope="col">Status</th>
                                <th scope="col">User (login)</th>
                                <th scope="col">Date</th>
                                <th scope="col">Time</th>
                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Count; i++)
                            {
                                <tr align="center" class="align-baseline">
                                    <td class="fw-bold">@(i + 1)</td>
                                    <td>@Model[i].TotalCost?.ToString("c")</td>
                                    <td>@Html.DisplayFor(m => Model[i].Status)</td>
                                    <td>@Model[i].UserId</td>
                                    <td>@Model[i].CreationDateTime.ToShortDateString()</td>
                                    <td>@Model[i].CreationDateTime.ToShortTimeString()</td>
                                    <td align="left">
                                        <a class="text-success"
                                           asp-area="Admin"
                                           asp-controller="Order"
                                           asp-action="Detail"
                                           asp-route-orderId="@Model[i].Id">
                                            Read More
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr align="center">
                                <th colspan="4"></th>
                                <th colspan="3">
                                    Total number of orders: @Model.Count
                                </th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="text-center">
                <h2 class="row-title">There are no orders in the repository!</h2>
            </div>
        }

    </div>
</div>