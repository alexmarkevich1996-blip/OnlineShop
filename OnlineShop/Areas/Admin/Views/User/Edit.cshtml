@model UserAccount
@{
    ViewData["Title"] = "Edit user data";
}

<div class="text-center text-uppercase text-success mb-5 mt-5">
    <h2 class="row-title">Edit user data</h2>
</div>

<form method="post">
    <div class="row justify-content-center mt-3">
        <div class="col-6 mb-3">
            <div class="text-danger fw-bold text-uppercase" asp-validation-summary="All"></div>
            <input type="hidden" name="Id" value="@Model.Id" />

            <p>
                <label class="form-label" asp-for="Name"></label><br />
                <input class="form-control" asp-for="Name" value="@Model.Name" />
                <span asp-validation-for="Name"></span>
            </p>
            <p>
                <label class="form-label" asp-for="Surname"></label><br />
                <input class="form-control" asp-for="Surname" value="@Model.Surname" />
                <span asp-validation-for="Surname"></span>
            </p>
            <p>
                <label class="form-label" asp-for="Age"></label><br />
                <input class="form-control" asp-for="Age" value="@Model.Age" />
                <span asp-validation-for="Age"></span>
            </p>
            <p>
                <label class="form-label" asp-for="Phone"></label><br />
                <input class="form-control" asp-for="Phone" value="@Model.Phone" />
                <span asp-validation-for="Phone"></span>
            </p>
            <p>
                <label class="form-label" asp-for="Login"></label><br />
                <input class="form-control" asp-for="Login" value="@Model.Login" readonly="readonly" />
                <span asp-validation-for="Login"></span>
            </p>
            <p>
                <label class="form-label" asp-for="Password"></label><br />
                <input class="form-control" asp-for="Password" value="@Model.Password" readonly="readonly" />
                <span asp-validation-for="Password"></span>
            </p>
        </div>
    </div>
    <div class="text-center m-3">
        <button class="btn btn-outline-success" type="submit"
            asp-area="Admin"
            asp-controller="User"
            asp-action="Edit">
            Edit
        </button>
    </div>
</form>