@model List<UserAccount>
@{
    ViewData["Title"] = "Users";
}

<div class="row mt-3">
    @await Html.PartialAsync("SideBar")
    <div class="col-9 mb-3">
        <div class="text-center text-uppercase text-success mb-5 mt-5">
            <h2 class="row-title">Users</h2>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            <div class="row justify-content-center mt-3">
                <div class="col-12">
                    <div class="text-end">
                        <a class="btn btn-outline-success mb-2 mt-2"
                           asp-area="Admin"
                           asp-controller="User"
                           asp-action="Add">
                            Add new user
                        </a>
                    </div>
                    <table class="table table-responsive table-striped table-hover mb-5">
                        <thead>
                            <tr align="center">
                                <th scope="col">#</th>
                                <th scope="col">Email (login)</th>
                                <th scope="col">Name</th>
                                <th scope="col">Surname</th>
                                <th scope="col">Phone</th>
                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Count; i++)
                            {
                                <tr align="center" class="align-baseline">
                                    <td class="fw-bold">@(i + 1)</td>
                                    <td align="left">
                                        <a class="text-success"
                                           asp-area="ОБЛАСТЬ"
                                           asp-controller="КОНТРОЛЛЕР"
                                           asp-action="МЕТОД_КОНТРОЛЛЕРА"
                                           asp-route-id="ID_ПОЛЬЗОВАТЕЛЯ">
                                            <h5>@Model[i].Login</h5>
                                        </a>
                                    </td>
                                    <td>@Model[i].Name</td>
                                    <td>@Model[i].Surname</td>
                                    <td>@Model[i].Phone</td>
                                    <td align="left">
                                        <a class="text-success"
                                           asp-area="Admin"
                                           asp-controller="User"
                                           asp-action="Detail"
                                           asp-route-login="@Model[i].Login">
                                            Detail
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr align="center">
                                <th colspan="3"></th>
                                <th colspan="3">
                                    Total number of users: @Model.Count
                                </th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="text-center">
                <h2 class="row-title">There are no users in repository!</h2>
            </div>
            <div class="text-center mt-5">
                <a class="btn btn-outline-success mb-2 mt-2"
                   asp-area="Admin"
                   asp-controller="User"
                   asp-action="Add">
                    Add new user
                </a>
            </div>
        }
    </div>
</div>