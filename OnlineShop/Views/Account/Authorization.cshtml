
@{
    ViewData["Title"] = "User Authorization";
}

<div class="text-center text-uppercase text-success mb-5 mt-5">
    <h2 class="row-title">Log in</h2>
</div>
<form method="post">
    <div class="row justify-content-center mt-3">
        <div class="col-6 mb-3">
            <p>
                <label class="form-label">Login</label><br />
                <input class="form-control" placeholder="Your login" required name="login" />
            </p>
            <p>
                <label class="form-label">Password</label><br />
                <input class="form-control" placeholder="Your password" required name="password" />
            </p>
            <p>
                <label class="form-check-label">Remember Me</label>
                <input class="form-check-input" type="checkbox" value="true" name="isRememberMe" />
            </p>
        </div>
    </div>
    <div class="text-center m-3">
        <button class="btn btn-outline-success" type="submit"
                asp-controller="Account"
                asp-action="Authorization">
            Log In
        </button>
    </div>
    <div class="text-center m-3">
        <a class="btn text-decoration-underline"
           asp-controller="Account"
           asp-action="Register">
            New User Registration
        </a>
    </div>
</form>