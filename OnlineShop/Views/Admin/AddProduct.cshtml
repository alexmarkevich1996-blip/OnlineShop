
@{
    ViewData["Title"] = "Add Product";
}

<div class="text-center text-uppercase text-success mb-5 mt-5">
    <h2 class="row-title">Add new product</h2>
</div>
<form method="post">
    <div class="row justify-content-center mt-3">
        <div class="col-6 mb-3">
            <p>
                <label class="form-label">Product name</label><br />
                <input class="form-control" placeholder="Product name" name="name" />
            </p>
            <p>
                <label class="form-label">Cost, usd</label><br />
                <input class="form-control" placeholder="cost, usd" name="cost" />
            </p>
            <p>
                <label class="form-label">Product description</label><br />
                <input class="form-control" placeholder="Product description" name="description" />
            </p>
        </div>
    </div>
    <div class="text-center m-3">
        <button class="btn btn-outline-success" type="submit"
            asp-controller="Admin"
            asp-action="AddProduct">
            Add
        </button>
    </div>
</form>