@model Product
@{
    ViewData["Title"] = "Product editing";
}

<div class="text-center text-uppercase text-success mb-5 mt-5">
    <h2 class="row-title">Product editing</h2>
</div>
<form method="post">
    <div class="row justify-content-center mt-3">
        <div class="col-6 mb-3">
            <input type="hidden" name="id" value="@Model.Id" />
            <p>
                <label class="form-label">Product Name</label><br />
                <input class="form-control" placeholder="Product Name" name="name" value="@Model.Name"/>
            </p>
            <p>
                <label class="form-label">Cost, usd.</label><br />
                <input class="form-control" placeholder="Cost, usd." name="cost" value="@Model.Cost"/>
            </p>
            <p>
                <label class="form-label">Description</label><br />
                <input class="form-control" placeholder="Description" name="description" value="@Model.Description"/>
            </p>
        </div>
    </div>
    <div class="text-center m-3">
        <button class="btn btn-outline-success" type="submit"
            asp-controller="Admin"
            asp-action="EditProduct">
            Edit
        </button>
    </div>
</form>