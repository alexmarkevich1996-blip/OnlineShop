@model Cart

<div class="row justify-content-evenly">

    @if (Model != null && Model.Items.Count > 0)
    {
        <div class="col-9">
            <table class="table table-striped table-hover text-center align-middle"
                   style="table-layout: fixed; width: 100%;">
                <thead>
                    <tr>
                        <th style="width: 5%;">#</th>
                        <th style="width: 30%;">Product Name</th>
                        <th style="width: 20%;">Price, usd</th>
                        <th style="width: 20%;">Quantity #</th>
                        <th style="width: 25%;">Cost, usd</th>
                    </tr>
                </thead>

                <tbody>
                    @for (var i = 0; i < Model.Items.Count; i++)
                    {
                        <tr>
                            <td class="fw-bold">@(i + 1)</td>
                            <td>@Model.Items[i].Product.Name</td>
                            <td>@Model.Items[i].Product.Cost</td>
                            <td>
                                <div class="d-flex justify-content-center align-items-center gap-3">

                                    <a class="btn btn-success"
                                       asp-controller="Cart"
                                       asp-action="Subtract"
                                       asp-route-productId="@Model.Items[i].Product.Id">
                                        -
                                    </a>

                                    <span>@Model.Items[i].Quantity</span>

                                    <a class="btn btn-success"
                                       asp-controller="Cart"
                                       asp-action="Add"
                                       asp-route-productId="@Model.Items[i].Product.Id">
                                        +
                                    </a>

                                </div>
                            </td>
                            <td class="fw-bold">
                                @Model.Items[i].Cost.ToString("c")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="d-flex justify-content-center align-items-center gap-4 mt-3">
                <strong>
                    Total Cost: @Model.TotalCost.ToString("c")
                </strong>

                <a class="btn btn-success"
                   asp-controller="Cart"
                   asp-action="Index">
                    Place an Order
                </a>
            </div>

        </div>
    }
    else
    {
        <div class="col-auto m-5">
            <h2 class="row-title">There are no products in the cart!</h2>
        </div>

    }
</div>




<div class="d-flex justify-content-center mt-3">
    <a class="btn btn-outline-danger"
       asp-controller="Cart"
       asp-action="Clear">
        Clear Cart
    </a>
</div>

<div class="d-flex justify-content-center mt-4">
    <a class="btn btn-outline-success"
       asp-controller="Home"
       asp-action="Index">
        Continue shopping
    </a>
</div>