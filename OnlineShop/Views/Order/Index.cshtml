@model Cart
@{
    ViewData["Title"] = "Placing an Order";
}
<form method="post">
    <div class="text-center text-uppercase text-success mb-5 mt-5">
        <h2 class="row-title">Placing an Order</h2>
    </div>

    @if (Model != null && Model.Items.Count > 0)
    {
        <div class="row justify-content-center mt-3">
            <div class="col">
                <table class="table table-borderless">
                    <thead>
                        <tr align="center">
                            <th><h2>User's Info</h2></th>
                            <th><h2>Order's Info</h2></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="w-50 p-4">
                                <p>
                                    <label class="form-label">Name</label><br />
                                    <input type="text" class="form-control" placeholder="Ivanov" name="name"/>
                                </p>
                                <p>
                                    <labe class ="form-label">Delivery Address</labe><br />
                                    <input type="text" class="form-control" placeholder="St Petersburg, Kosygina st., 25-117" name="address"/>
                                </p>
                                <p>
                                    <label class="form-label">Phone Number</label><br />
                                    <input type="tel" class="form-control" placeholder="+7 (__)___-__-__" name="phone" />
                                </p>
                                <p>
                                    <label class="form-label">Delivery Date</label><br />
                                    <input type="date" class="form-control" pattern="\d{2}\.d{2}\.\d{4}" placeholder="01.01.1900" name="date" />
                                </p>
                                <p>
                                    <label class="form-label">Comment</label><br />
                                    <textarea class="form-control" placeholder="Comment" name="comment"></textarea>
                                </p>
                            </td>

                            <td class="w-50 p-4">
                                <table class="table table-responsive table-striped table-hover mb-5 caption-top">
                                    <thead>
                                        <tr>
                                            <th style="width: 5%;">#</th>
                                            <th style="width: 30%;">Product Name</th>
                                            <th style="width: 20%;">Price, usd</th>
                                            <th style="width: 20%;">Quantity #</th>
                                            <th style="width: 25%;">Cost, usd</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < Model.Items.Count; i++)
                                        {
                                            <tr>
                                                <td class="fw-bold">@(i + 1)</td>
                                                <td>@Model.Items[i].Product.Name</td>
                                                <td>@Model.Items[i].Product.Cost</td>
                                                <td>@Model.Items[i].Quantity</td>
                                                <td class="fw-bold">
                                                    @Model.Items[i].Cost.ToString("c")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-borderless ">
                                        <tr align="center">
                                            <th colspan="5">
                                                Total Cost: @Model.TotalCost.ToString("c")
                                            </th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="text-center">
            <button class="btn btn-outline-danger" type="submit"
               asp-controller="Order"
               asp-action="Buy">
                Pay for the order
            </button>
        </div>
    }
    else
    {
        <div class="text-center">
            <h2 class="row-title">There is no order to process!</h2>
        </div>
    }

    <div class="text-center m-5">
        <a class="btn btn-outline-success"
           asp-controller="Home"
           asp-action="Index">
            Continue shopping
        </a>
    </div>
</form>