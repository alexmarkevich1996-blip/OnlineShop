@model List<Product>

<div class="row justify-content-center mt-3">
    @if (Model != null && Model.Count > 0)
    {
        @foreach (var product in Model)
        {
            <div class="col-3" mb="3">
                <div class="card shadow">
                    <img class="card-img-top" src=@product.PhotoPath>
                    <div class="card-body text-center">
                        <a class="text-success"
                           asp-controller="Product"
                           asp-action="Index"
                           asp-route-id="@product.Id">
                            <h5>@product.Name</h5>
                        </a>
                        <h2 class="text-danger">@product.Cost.ToString("c")</h2>
                        <a class="btn btn-success"
                           asp-controller="Cart"
                           asp-action="Add"
                           asp-route-productId="@product.Id">Add to shopping cart</a>
                        <a class="btn btn-danger mt-2"
                           asp-controller="Favorite"
                           asp-action="Add"
                           asp-route-productId="@product.Id">
                            Add to Favorites
                        </a>
                        <a class="btn btn-warning mt-2"
                           asp-controller="Comparison"
                           asp-action="Add"
                           asp-route-productId="@product.Id">
                            Add to Comparison
                        </a>
                    </div>

                </div>
            </div>
        }
        

    }
    else
    {
        <div class="text-center">
            <h2>There are no products for display!</h2>
        </div>
    }

</div>